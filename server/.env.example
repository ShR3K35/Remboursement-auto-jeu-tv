# Jeton partagé avec l'app Android (au moins 32 caractères) : openssl rand -hex 32
APP_API_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys) — commencez avec les clés de test (sk_test_/pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret du webhook (Dashboard > Développeurs > Webhooks, événements payment_intent.succeeded et payment_intent.payment_failed)
STRIPE_WEBHOOK_SECRET=

# Maileva (groupe La Poste) — compte API à demander sur maileva.com ; sandbox par défaut
MAILEVA_ENV=sandbox
MAILEVA_CLIENT_ID=
MAILEVA_CLIENT_SECRET=
MAILEVA_USERNAME=
MAILEVA_PASSWORD=
# ECONOMIC (lent, comme le timbre remboursé) ou FAST
MAILEVA_POSTAGE_TYPE=ECONOMIC

# Prix facturé par lettre : base + par page (centimes). Ajustez selon votre tarif Maileva.
PRICE_BASE_CENTS=250
PRICE_PER_PAGE_CENTS=25
MAX_PAGES=40

PORT=8080
DATA_DIR=./data
